{
  "name": "3d-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": "^22.18.0 || >=24" },
  "scripts": {
    "build:viewer": "vite build --config vite.viewer.config.ts",
    "dev": "vite build --config vite.viewer.config.ts && vite",
    "build": "tsc --noEmit && vite build --config vite.viewer.config.ts && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && node --experimental-strip-types --test eval/regression.test.ts",
    "evaluate": "node --experimental-strip-types --env-file-if-exists=.env eval/run.ts",
    "portable": "vite build --config vite.viewer.config.ts && node --experimental-strip-types scripts/portable.ts",
    "decisions": "node --experimental-strip-types scripts/decisions.ts",
    "start": "node --env-file-if-exists=.env artifacts/Career-Exhibit-Generator/generator.mjs",
    "kit": "pnpm portable && pnpm decisions && node --experimental-strip-types scripts/generator-kit.ts",
    "sample": "vite build --config vite.viewer.config.ts && node --experimental-strip-types scripts/sample.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.4.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.554.0",
    "pdfjs-dist": "^5.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.181.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
